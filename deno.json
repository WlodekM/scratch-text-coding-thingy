{
  "tasks": {
    "run": "deno run -A ./src/main.ts project",
    "run-and-open": "deno run -A ./src/main.ts project && turbowarp-desktop project/project.sb3",
    "open": "turbowarp-desktop project/project.sb3",
    "getblocksjson": "deno -A ./src/getblocksjson.ts",
    "run2": "deno run -A ./src/v2/main.ts tproject",
    "run-and-open2": "deno run -A ./src/v2/main.ts tproject && turbowarp-desktop tproject/project.sb3",
    "open2": "turbowarp-desktop tproject/project.sb3"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/yaml": "jsr:@std/yaml@^1.0.10",
    "@zip-js/zip-js": "jsr:@zip-js/zip-js@^2.8.8"
  },
  "lint": {
    "rules": {
      "exclude": ["no-explicit-any"]
    }
  },
  "fmt": {
    "options": {
      "useTabs": true
    }
  }
}
